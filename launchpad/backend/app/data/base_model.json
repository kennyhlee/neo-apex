{
  "tenant": {
    "base_fields": [
      {"name": "name", "type": "str", "required": true},
      {"name": "display_name", "type": "str", "required": false},
      {"name": "contact_email", "type": "email", "required": false},
      {"name": "contact_phone", "type": "phone", "required": false},
      {"name": "primary_address", "type": "str", "required": false},
      {"name": "mailing_address", "type": "str", "required": false},
      {"name": "license_number", "type": "str", "required": false},
      {"name": "capacity", "type": "number", "required": false},
      {"name": "accreditation", "type": "str", "required": false},
      {"name": "insurance_provider", "type": "str", "required": false},
      {"name": "note", "type": "str", "required": false},
      {"name": "stripe_account_id", "type": "str", "required": false}
    ],
    "custom_fields": []
  },
  "student": {
    "base_fields": [
      {"name": "student_id", "type": "str", "required": true},
      {"name": "first_name", "type": "str", "required": true},
      {"name": "last_name", "type": "str", "required": true},
      {"name": "middle_name", "type": "str", "required": false},
      {"name": "preferred_name", "type": "str", "required": false},
      {"name": "dob", "type": "date", "required": false},
      {"name": "grade_level", "type": "selection", "required": false, "options": ["TK", "Kinder", "1st", "2nd", "3rd", "4th", "5th"]},
      {"name": "email", "type": "email", "required": false},
      {"name": "gender", "type": "selection", "required": false, "options": ["Male", "Female", "Non-binary", "Prefer not to say"]},
      {"name": "status", "type": "selection", "required": false, "options": ["Active", "Inactive", "Enrolled", "Withdrawn", "Graduated", "Waitlisted", "Suspended", "Transferred"]},
      {"name": "family_id", "type": "str", "required": true},
      {"name": "primary_address", "type": "str", "required": true},
      {"name": "mailing_address", "type": "str", "required": false},
      {"name": "grade", "type": "str", "required": false},
      {"name": "school_attending", "type": "str", "required": false},
      {"name": "allergies", "type": "str", "required": false},
      {"name": "dietary_restrictions", "type": "str", "required": false},
      {"name": "medications", "type": "str", "required": false},
      {"name": "physician_name", "type": "str", "required": false},
      {"name": "physician_phone", "type": "phone", "required": false},
      {"name": "insurance_carrier", "type": "str", "required": false},
      {"name": "insurance_policy", "type": "str", "required": false},
      {"name": "special_needs_notes", "type": "str", "required": false},
      {"name": "photo_media_release", "type": "bool", "required": false}
    ],
    "custom_fields": []
  },
  "family": {
    "base_fields": [
      {"name": "family_id", "type": "str", "required": true},
      {"name": "family_name", "type": "str", "required": true},
      {"name": "primary_address", "type": "str", "required": true},
      {"name": "mailing_address", "type": "str", "required": false},
      {"name": "primary_phone", "type": "phone", "required": false},
      {"name": "primary_email", "type": "email", "required": false},
      {"name": "guardian2_name", "type": "str", "required": false},
      {"name": "guardian2_phone", "type": "phone", "required": false},
      {"name": "guardian2_email", "type": "email", "required": false},
      {"name": "guardian2_relationship", "type": "str", "required": false},
      {"name": "guardian1_employer", "type": "str", "required": false},
      {"name": "guardian2_employer", "type": "str", "required": false},
      {"name": "address_street", "type": "str", "required": false},
      {"name": "address_city", "type": "str", "required": false},
      {"name": "address_state", "type": "str", "required": false},
      {"name": "address_zip", "type": "str", "required": false}
    ],
    "custom_fields": []
  },
  "contact": {
    "base_fields": [
      {"name": "contact_id", "type": "str", "required": true},
      {"name": "first_name", "type": "str", "required": true},
      {"name": "last_name", "type": "str", "required": true},
      {"name": "relationship", "type": "str", "required": true},
      {"name": "phone", "type": "phone", "required": false},
      {"name": "email", "type": "email", "required": false},
      {"name": "is_emergency", "type": "bool", "required": false},
      {"name": "is_authorized_pickup", "type": "bool", "required": false},
      {"name": "family_id", "type": "str", "required": true},
      {"name": "is_pickup_excluded", "type": "bool", "required": false}
    ],
    "custom_fields": []
  },
  "program": {
    "base_fields": [
      {"name": "program_id", "type": "str", "required": true},
      {"name": "name", "type": "str", "required": true},
      {"name": "description", "type": "str", "required": false},
      {"name": "start_date", "type": "date", "required": false},
      {"name": "end_date", "type": "date", "required": false},
      {"name": "capacity", "type": "number", "required": false},
      {"name": "status", "type": "selection", "required": false, "options": ["Active", "Inactive", "Planned", "Completed"]}
    ],
    "custom_fields": []
  },
  "enrollment": {
    "base_fields": [
      {"name": "enrollment_id", "type": "str", "required": true},
      {"name": "student_id", "type": "str", "required": true},
      {"name": "program_id", "type": "str", "required": true},
      {"name": "enrollment_date", "type": "date", "required": true},
      {"name": "status", "type": "selection", "required": false, "options": ["Active", "Withdrawn", "Completed", "Waitlisted"]},
      {"name": "notes", "type": "str", "required": false}
    ],
    "custom_fields": []
  },
  "lead": {
    "base_fields": [
      {"name": "lead_id", "type": "str", "required": true},
      {"name": "guardian_name", "type": "str", "required": true},
      {"name": "email", "type": "email", "required": false},
      {"name": "phone", "type": "phone", "required": false},
      {"name": "student_first_name", "type": "str", "required": false},
      {"name": "student_last_name", "type": "str", "required": false},
      {"name": "grade_of_interest", "type": "str", "required": false},
      {"name": "message", "type": "str", "required": false},
      {"name": "source", "type": "selection", "required": false, "options": ["web_form", "manual", "email_import"], "multiple": false},
      {"name": "stage", "type": "selection", "required": false, "options": ["New", "Contacted", "Tour Scheduled", "Toured", "Enrolled", "Lost"], "multiple": false},
      {"name": "converted_family_id", "type": "str", "required": false}
    ],
    "custom_fields": []
  },
  "attendance": {
    "base_fields": [
      {"name": "attendance_id", "type": "str", "required": true},
      {"name": "student_id", "type": "str", "required": true},
      {"name": "program_id", "type": "str", "required": true},
      {"name": "date", "type": "date", "required": true},
      {"name": "status", "type": "selection", "required": true, "options": ["Present", "Absent", "Tardy", "Excused"]},
      {"name": "notes", "type": "str", "required": false}
    ],
    "custom_fields": []
  },
  "registration_application": {
    "base_fields": [
      {"name": "application_id", "type": "str", "required": true},
      {"name": "school_year", "type": "str", "required": false},
      {"name": "student_id", "type": "str", "required": false},
      {"name": "family_id", "type": "str", "required": false},
      {"name": "requested_start_date", "type": "date", "required": false},
      {"name": "schedule_days", "type": "str", "required": false},
      {"name": "pickup_method", "type": "str", "required": false},
      {"name": "handbook_acknowledged", "type": "bool", "required": false},
      {"name": "liability_waiver_signed", "type": "bool", "required": false},
      {"name": "tuition_agreement_signed", "type": "bool", "required": false},
      {"name": "signature_name", "type": "str", "required": false},
      {"name": "signature_date", "type": "date", "required": false}
    ],
    "custom_fields": []
  },
  "workflow_definition": {
    "base_fields": [
      {"name": "definition_id", "type": "str", "required": true},
      {"name": "name", "type": "str", "required": true},
      {"name": "version", "type": "number", "required": true},
      {"name": "status", "type": "selection", "required": true, "options": ["draft", "published", "superseded"], "default": "draft"},
      {"name": "lineage_status", "type": "selection", "required": true, "options": ["active", "deprecated", "retired"], "default": "active"},
      {"name": "channel_access", "type": "selection", "required": true, "options": ["staff_only", "family"], "default": "staff_only"},
      {"name": "machine", "type": "str", "required": true},
      {"name": "steps", "type": "str", "required": true}
    ],
    "custom_fields": []
  },
  "workflow_instance": {
    "base_fields": [
      {"name": "instance_id", "type": "str", "required": true},
      {"name": "definition_id", "type": "str", "required": true},
      {"name": "definition_version", "type": "number", "required": true},
      {"name": "state", "type": "str", "required": true},
      {"name": "subject_refs", "type": "str", "required": false},
      {"name": "context", "type": "str", "required": false},
      {"name": "channel_started", "type": "selection", "required": true, "options": ["family", "staff"]},
      {"name": "applicant_email", "type": "email", "required": false},
      {"name": "token_version", "type": "number", "required": false, "default": 1},
      {"name": "draft_data", "type": "str", "required": false},
      {"name": "opened_at", "type": "datetime", "required": true},
      {"name": "closed_at", "type": "datetime", "required": false}
    ],
    "custom_fields": []
  },
  "workflow_item": {
    "base_fields": [
      {"name": "item_id", "type": "str", "required": true},
      {"name": "instance_id", "type": "str", "required": true},
      {"name": "step_id", "type": "str", "required": true},
      {"name": "kind", "type": "selection", "required": true, "options": ["form", "documents", "message-ack"]},
      {"name": "title", "type": "str", "required": true},
      {"name": "status", "type": "selection", "required": true, "options": ["not_started", "in_progress", "submitted", "verified", "rejected", "waived"], "default": "not_started"},
      {"name": "blocking", "type": "bool", "required": true},
      {"name": "due_at", "type": "datetime", "required": false},
      {"name": "completed_by", "type": "str", "required": false},
      {"name": "payload_ref", "type": "str", "required": false}
    ],
    "custom_fields": []
  },
  "workflow_activity": {
    "base_fields": [
      {"name": "activity_id", "type": "str", "required": true},
      {"name": "instance_id", "type": "str", "required": true},
      {"name": "type", "type": "selection", "required": true, "options": ["state_change", "item_change", "note", "email_sent"]},
      {"name": "from_value", "type": "str", "required": false},
      {"name": "to_value", "type": "str", "required": false},
      {"name": "actor", "type": "str", "required": true},
      {"name": "at", "type": "datetime", "required": true}
    ],
    "custom_fields": []
  },
  "document": {
    "base_fields": [
      {"name": "document_id", "type": "str", "required": true},
      {"name": "application_id", "type": "str", "required": true},
      {"name": "item_id", "type": "str", "required": false},
      {"name": "filename", "type": "str", "required": true},
      {"name": "content_type", "type": "str", "required": true},
      {"name": "size", "type": "number", "required": true},
      {"name": "storage_key", "type": "str", "required": true},
      {"name": "sensitive", "type": "bool", "required": true, "default": false},
      {"name": "uploaded_by", "type": "str", "required": true},
      {"name": "uploaded_at", "type": "datetime", "required": true}
    ],
    "custom_fields": []
  }
}
